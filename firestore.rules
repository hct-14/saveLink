rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Category Validation
    function isValidCategory(data) {
      return data.userId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        (!('parentId' in data) || data.parentId == null || (data.parentId is string && data.parentId.size() <= 128)) &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
        (!('order' in data) || (data.order is number));
    }

    // Bookmark Validation
    function isValidBookmark(data) {
      return data.userId == request.auth.uid &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 2048 &&
        data.cleanUrl is string && data.cleanUrl.size() >= 1 && data.cleanUrl.size() <= 2048 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('favicon' in data) || (data.favicon is string && data.favicon.size() <= 2048)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2048)) &&
        (!('categoryId' in data) || data.categoryId == null || (data.categoryId is string && data.categoryId.size() <= 128)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string))) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
        (!('isFavorite' in data) || (data.isFavorite is bool));
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(categoryId) &&
        isValidCategory(incoming()) &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(categoryId) &&
        existing().userId == request.auth.uid;
    }

    // Bookmarks collection
    match /bookmarks/{bookmarkId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(bookmarkId) &&
        isValidBookmark(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(bookmarkId) &&
        isValidBookmark(incoming()) &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(bookmarkId) &&
        existing().userId == request.auth.uid;
    }
  }
}
